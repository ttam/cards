{
    "name": "@bannon/cards",
    "version": "0.2.0",
    "description": "A small TypeScript toolkit for building games with standard playing cards, with no runtime dependencies",
    "keywords": [
        "playing cards",
        "cards",
        "deck"
    ],
    "homepage": "https://cards.js.org/",
    "bugs": {
        "url": "https://github.com/ttam/cards/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttam/cards.git"
    },
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "author": {
        "name": "Matt Bannon",
        "url": "https://mattbannon.com/"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "types": "./dist/index.d.ts",
    "sideEffects": [
        "./dist/cards.css"
    ],
    "style": "./dist/cards.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/cards.js"
        },
        "./cards.js": {
            "types": "./dist/index.d.ts",
            "import": "./dist/cards.js"
        },
        "./cards.css": "./dist/cards.css",
        "./assets/deck.svg": "./dist/assets/deck.svg"
    },
    "unpkg": "./dist/cards.js",
    "jsdelivr": "./dist/cards.js",
    "scripts": {
        "build": "npm run clean && rollup -c && node scripts/copy-browser-bundle.mjs",
        "changelog": "node scripts/update-changelog.mjs",
        "prepack": "npm run build",
        "preversion": "npm run check",
        "version": "npm run changelog && git add CHANGELOG.md",
        "dev": "rollup -c --watch",
        "clean": "rm -rf dist",
        "check:pr-title": "node scripts/check-pr-title.mjs",
        "format": "prettier --write \"**/*.{cjs,js,mjs,ts,json}\"",
        "format:check": "prettier --check \"**/*.{cjs,js,mjs,ts,json}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "jest --config jest.config.cjs",
        "coverage": "npm test -- --coverage",
        "docs:dev": "vitepress dev docs",
        "docs:build": "npm run build && vitepress build docs && node scripts/assemble-docs.mjs",
        "docs:preview": "vitepress preview docs",
        "example:blackjack": "node --import tsx examples/node/run.ts blackjack",
        "example:texas-hold-em": "node --import tsx examples/node/run.ts texas-hold-em",
        "package:check": "tsc --project test/package/tsconfig.json",
        "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build && npm run package:check"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@rollup/plugin-typescript": "^12.0.0",
        "@types/jest": "^29.5.14",
        "chalk": "^4.1.2",
        "conventional-changelog": "^8.1.3",
        "conventional-changelog-conventionalcommits": "^10.3.0",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.9.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "3.9.6",
        "rollup": "^4.0.0",
        "rollup-plugin-dts": "6.4.1",
        "ts-jest": "^29.4.6",
        "tslib": "^2.8.1",
        "tsx": "^4.23.12",
        "typescript": "^5.0.0",
        "typescript-eslint": "8.66.0",
        "vitepress": "^1.6.4"
    }
}

{
    "name": "@bannon/cards",
    "version": "0.1.0",
    "description": "A small TypeScript toolkit for building games with standard playing cards, with no runtime dependencies",
    "keywords": [
        "playing cards",
        "cards",
        "deck"
    ],
    "homepage": "https://ttam.github.io/cards/",
    "bugs": {
        "url": "https://github.com/ttam/cards/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttam/cards.git"
    },
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "author": {
        "name": "Matt Bannon",
        "url": "https://mattbannon.com/"
    },
    "files": [
        "dist"
    ],
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/cards.js"
        },
        "./cards.js": "./dist/cards.js"
    },
    "unpkg": "./dist/cards.js",
    "jsdelivr": "./dist/cards.js",
    "scripts": {
        "build": "npm run clean && rollup -c && node scripts/copy-browser-bundle.mjs",
        "dev": "rollup -c --watch",
        "clean": "rm -rf dist",
        "format": "prettier --write \"**/*.{cjs,js,mjs,ts,json}\"",
        "format:check": "prettier --check \"**/*.{cjs,js,mjs,ts,json}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "jest --config jest.config.cjs",
        "coverage": "npm test -- --coverage",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs && node scripts/assemble-docs.mjs",
        "docs:preview": "vitepress preview docs",
        "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@rollup/plugin-typescript": "^12.0.0",
        "@types/jest": "^29.5.14",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.9.0",
        "jest": "^29.7.0",
        "prettier": "3.9.6",
        "rollup": "^4.0.0",
        "rollup-plugin-dts": "^6.0.0",
        "ts-jest": "^29.4.6",
        "tslib": "^2.8.1",
        "typescript": "^5.0.0",
        "typescript-eslint": "8.66.0",
        "vitepress": "^1.6.4"
    }
}
